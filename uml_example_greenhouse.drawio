          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sms-handler" value="«bind» T → AlarmRaised" style="endArrow=block;dashed=1;endFill=0;endSize=12;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.88;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=default;fontSize=10;" edge="1" parent="1" source="sms" target="ihandler">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
