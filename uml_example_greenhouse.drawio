        <!-- Note -->
        <mxCell id="note-sms" value="Added during the demo: plugs into the bus without changing any other class." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="290" width="230" height="56" as="geometry" />
        </mxCell>

        <!-- Edges: messages realize IMessage -->
        <mxCell id="e-tm-imsg" value="" style="endArrow=block;dashed=1;endFill=0;endSize=12;html=1;rounded=0;" edge="1" parent="1" source="tm" target="imsg">
