          <mxGeometry y="40" width="170" height="40" as="geometry" />
        </mxCell>

        <!-- IMessageHandler<T> -->
        <mxCell id="ihandler" value="«interface»&lt;br&gt;IMessageHandler&amp;lt;T : IMessage&amp;gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
