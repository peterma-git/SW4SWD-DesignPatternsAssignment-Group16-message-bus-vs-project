          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="580" />
              <mxPoint x="1179" y="580" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Edge: bus aggregates handlers -->
        <mxCell id="e-bus-handler" value="subscribers&lt;br&gt;0..*" style="startArrow=diamondThin;startFill=0;startSize=14;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;labelBackgroundColor=default;" edge="1" parent="1" source="bus" target="ihandler">
