        </mxCell>
        <mxCell id="e-ar-imsg" value="" style="endArrow=block;dashed=1;endFill=0;endSize=12;html=1;rounded=0;" edge="1" parent="1" source="ar" target="imsg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: publishers use the bus -->
        <mxCell id="e-sensor-bus" value="publishes via" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;labelBackgroundColor=default;" edge="1" parent="1" source="sensor" target="bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-monitor-bus" value="publishes via" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;labelBackgroundColor=default;" edge="1" parent="1" source="monitor" target="bus">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="270" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Edges: publishers create messages -->
        <mxCell id="e-sensor-tm" value="«create»" style="endArrow=open;dashed=1;endFill=0;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=default;" edge="1" parent="1" source="sensor" target="tm">
          <mxGeometry relative="1" as="geometry">
