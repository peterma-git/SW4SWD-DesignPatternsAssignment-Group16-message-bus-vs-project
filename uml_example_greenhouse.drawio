        <mxCell id="monitor-a" value="- _bus : MessageBus&lt;br&gt;- _threshold : double" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="monitor">
          <mxGeometry y="26" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="monitor-l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="monitor">
          <mxGeometry y="66" width="300" height="8" as="geometry" />
        </mxCell>
        <mxCell id="monitor-o" value="+ Handle(message : TemperatureMeasured) : void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="monitor">
          <mxGeometry y="74" width="300" height="26" as="geometry" />
        </mxCell>

        <!-- Dashboard -->
        <mxCell id="dash" value="Dashboard" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="420" width="300" height="74" as="geometry" />
        </mxCell>
        <mxCell id="dash-l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="dash">
          <mxGeometry y="26" width="300" height="8" as="geometry" />
        </mxCell>
        <mxCell id="dash-o" value="+ Handle(message : TemperatureMeasured) : void&lt;br&gt;+ Handle(message : AlarmRaised) : void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="dash">
          <mxGeometry y="34" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- SmsNotifier (added in demo) -->
        <mxCell id="sms" value="SmsNotifier" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="420" width="240" height="60" as="geometry" />
