        <!-- Notes -->
        <mxCell id="note1" value="Publish(message): finds the subscribers for the message's type and calls Handle(message) on each of them." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="Publishers and subscribers never know each other - only the bus and the message types.&lt;br&gt;An application can be both." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1">
